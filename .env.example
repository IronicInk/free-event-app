# Copy to .env.local for local development, and add the same values in
# Vercel → Project → Settings → Environment Variables.
#
# Leave the Firebase values empty to run on built-in sample events.
# These are Firebase *web* settings: not secrets. Access is controlled by firestore.rules.
# Find them in Firebase console → Project settings → Your apps → Web app.

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: your custom domain, used for share previews.
NEXT_PUBLIC_SITE_URL=
