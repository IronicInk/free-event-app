{
  "name": "valley-vibe-functions",
  "private": true,
  "description": "Nightly data pull and operator functions for Valley Vibe (PROJECT_REQUIREMENTS.md §7).",
  "main": "lib/functions/src/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test lib/functions/test/*.test.js",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions,firestore",
    "set-curator": "npm run build && node lib/functions/src/scripts/set-curator.js",
    "seed-sources": "npm run build && node lib/functions/src/scripts/seed-sources.js"
  },
  "dependencies": {
    "firebase-admin": "14.5.1",
    "firebase-functions": "7.4.0",
    "node-ical": "0.27.6"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
